# ===========================================
# DriveCommand Mobile Environment Variables
# ===========================================
# Copy this file to .env.local for local development
# For EAS builds: add these in eas.json or the Expo dashboard

# -------------------------------------------
# Backend API (required)
# -------------------------------------------
# URL of the DriveCommand web backend
# Android emulator: use http://10.0.2.2:3000 (maps to host machine localhost)
# iOS simulator:    use http://localhost:3000
# Production:       use your deployed domain (e.g. https://app.drivecommand.com)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# -------------------------------------------
# Supabase Auth (required — Supabase project keys)
# -------------------------------------------
# Get from: Supabase Dashboard -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -------------------------------------------
# Error Monitoring — Sentry (optional — enables error tracking)
# -------------------------------------------
# Get from: https://sentry.io -> Project Settings -> Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# -------------------------------------------
# Google Maps (optional — enables map features)
# -------------------------------------------
# Get from: https://console.cloud.google.com -> APIs & Services -> Credentials
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
