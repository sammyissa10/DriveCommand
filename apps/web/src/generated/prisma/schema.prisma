// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  OWNER
  MANAGER
  DRIVER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum SafetyEventType {
  HARSH_BRAKING
  HARSH_ACCELERATION
  HARSH_CORNERING
  SPEEDING
  DISTRACTED_DRIVING
  ROLLING_STOP
  SEATBELT_VIOLATION
  FOLLOWING_TOO_CLOSE
}

enum SafetyEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FuelType {
  DIESEL
  GASOLINE
  ELECTRIC
  HYBRID
  CNG
  LPG
}

enum PaymentStatus {
  PENDING
  PAID
}

enum DocumentType {
  DRIVER_LICENSE
  DRIVER_APPLICATION
  GENERAL
  RATE_CONFIRMATION
  // Restricted PII document types (quick-348) — land under tenant-{id}/restricted/ prefix
  SSN_CARD
  PASSPORT
  CDL_SCAN
  MEDICAL_CARD
  VOIDED_CHECK
  W9
  W4
  I9
}

enum IntegrationProvider {
  QUICKBOOKS
  SAMSARA
  KEEP_TRUCKIN
  TRIUMPH_FACTORING
  OTR_SOLUTIONS
  SENDGRID
  MAILGUN
}

enum IntegrationCategory {
  ACCOUNTING
  ELD
  FACTORING
  EMAIL
}

enum RouteStopType {
  PICKUP
  DELIVERY
}

enum RouteStopStatus {
  PENDING
  ARRIVED
  DEPARTED
}

enum InAppNotificationType {
  dispatch_assigned
  load_delivered
  pay_record_ready
  invoice_generated
  compliance_alert
  stop_completed
  needs_assignment
  dispatch_generated
  fleet_message
  trip_change
}

// Models
model Tenant {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String            @unique
  timezone              String            @default("UTC")
  contactEmail          String?
  plan                  String            @default("starter")
  isActive              Boolean           @default(true)
  profitMarginThreshold Decimal           @default(10) @db.Decimal(5, 2)
  createdAt             DateTime          @default(now()) @db.Timestamptz
  updatedAt             DateTime          @updatedAt @db.Timestamptz
  fleetSizeBucket       FleetSizeBucket   @default(OWNER_OPERATOR)
  truckCount            Int?
  heardAbout            String?
  heardAboutOther       String?
  status                TenantStatus      @default(ACTIVE)
  manualTrial           Boolean           @default(false)
  emailConfirmedAt      DateTime?         @db.Timestamptz
  sampleDataSeeded      Boolean           @default(false)
  provisioningPhase     ProvisioningPhase @default(MINIMAL)

  // ─── Document Import tenant settings (Phase 1, spec Section 6) ────────────
  // No TenantSettings table exists; these follow the precedent set by
  // truckCount / heardAbout (audit B3).
  autoCreateRouteTemplatesFromImports Boolean @default(false)
  defaultEndStopPolicy                String  @default("NONE")
  homeBaseFacilityId                  String? @db.Uuid
  requirePreTripInspection            Boolean @default(false)
  blockTripStartOnFailedInspection    Boolean @default(true)

  users                User[]
  trucks               Truck[]
  driverInvitations    DriverInvitation[]
  routes               Route[]
  documents            Document[]
  maintenanceEvents    MaintenanceEvent[]
  scheduledServices    ScheduledService[]
  notificationLogs     NotificationLog[]
  gpsLocations         GPSLocation[]
  safetyEvents         SafetyEvent[]
  fuelRecords          FuelRecord[]
  tags                 Tag[]
  tagAssignments       TagAssignment[]
  expenseCategories    ExpenseCategory[]
  expenseTemplates     ExpenseTemplate[]
  routeExpenses        RouteExpense[]
  routePayments        RoutePayment[]
  customers            Customer[]
  customerInteractions CustomerInteraction[]
  invoices             Invoice[]
  invoiceItems         InvoiceItem[]
  payrollRecords       PayrollRecord[]
  expenseTemplateItems ExpenseTemplateItem[]
  loads                Load[]
  tenantIntegrations   TenantIntegration[]
  routeStops           RouteStop[]
  sysAdminInvoices     SysAdminInvoice[]
  driverRouteJoins     DriverRouteJoin[]
  driverHOSEntries     DriverHOSEntry[]
  driverIncidents      DriverIncident[]

  // Carrier Operations reverse relations
  carrierClients        CarrierClient[]
  carrierClientContacts CarrierClientContact[]
  carrierContracts      CarrierContract[]
  carrierFacilities     CarrierFacility[]
  carrierDrivers        CarrierDriver[]
  carrierTrucks         CarrierTruck[]
  routeTemplates        RouteTemplate[]
  trips                 Trip[]
  carrierLoads          CarrierLoad[]
  carrierExpenses       CarrierExpense[]
  driverPayRecords      DriverPayRecord[]
  inAppNotifications    InAppNotification[]
  carrierDocumentTypes  CarrierDocumentType[]

  // Workflow Engine reverse relations
  stepTemplates          StepTemplate[]
  playbooks              Playbook[]
  playbookInstances      PlaybookInstance[]
  playbookNotifications  PlaybookNotification[]
  playbookTriggers       PlaybookTrigger[]
  dispatchOverrideAudits DispatchOverrideAudit[]

  // Phase 47 reverse relations
  subscription       Subscription?
  activationProgress ActivationProgress?
  automationRules    AutomationRule[]
  automationRuns     AutomationRun[]
  appEvents          AppEvent[]
  tenantMetrics      TenantMetricsDaily[]
  tenantHealthScore  TenantHealthScore?

  // Driver Pay reverse relations
  driverCompTemplates     DriverCompensationTemplate[]
  loadDriverAssignments   LoadDriverAssignment[]
  loadPayComponents       LoadPayComponent[]
  driverBonuses           DriverBonus[]
  driverDeductions        DriverDeduction[]
  driverSettlements       DriverSettlement[]
  payComponentAttachments PayComponentAttachment[]
  driverDisputes          DriverDispute[]
  driverPayAuditLogs      DriverPayAuditLog[]
  docFeedback             DocFeedback[]

  // Notification System reverse relations
  notificationSettings      TenantNotificationSettings[]
  notificationSubscriptions NotificationSubscription[]

  // quick-327 new tenant_id reverse relations
  playbookSteps PlaybookStep[]
  pushTokens    PushToken[]
  routeDrivers  RouteDriver[]
  stepInstances StepInstance[]

  // quick-329 PII audit log reverse relation
  auditLogs                   AuditLog[]
  sysAdminInvoiceItems        SysAdminInvoiceItem[]
  userNotificationPreferences UserNotificationPreference[]

  // Document Import reverse relations (Phase 1)
  documentImports            DocumentImport[]
  documentImportPages        DocumentImportPage[]
  facilityExternalReferences FacilityExternalReference[]
  documentProfiles           DocumentProfile[]
  homeBaseFacility           CarrierFacility?            @relation(name: "TenantHomeBase", fields: [homeBaseFacilityId], references: [id], onDelete: SetNull)
}

model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @db.Uuid
  email              String
  passwordHash       String?
  role               UserRole
  isSystemAdmin      Boolean  @default(false)
  firstName          String?
  lastName           String?
  licenseNumber      String?
  isActive           Boolean  @default(true)
  permissions        Json?
  isDispatchReady    Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz
  isSample           Boolean  @default(false)
  onboardingTourSeen Boolean  @default(false)

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  assignedRoutes    Route[]
  uploadedDocuments Document[]
  driverDocuments   Document[]        @relation(name: "DriverDocuments")
  safetyEvents      SafetyEvent[]
  tagAssignments    TagAssignment[]
  payrollRecords    PayrollRecord[]
  driverLoads       Load[]            @relation(name: "DriverLoads")
  routeCoDrivers    RouteDriver[]     @relation(name: "RouteCoDrivers")
  trucksCreated     Truck[]           @relation(name: "TruckCreatedBy")
  trucksUpdated     Truck[]           @relation(name: "TruckUpdatedBy")
  routesCreated     Route[]           @relation(name: "RouteCreatedBy")
  routesUpdated     Route[]           @relation(name: "RouteUpdatedBy")
  routesDeleted     Route[]           @relation(name: "RouteDeletedBy")
  loadsCreated      Load[]            @relation(name: "LoadCreatedBy")
  loadsUpdated      Load[]            @relation(name: "LoadUpdatedBy")
  invoicesCreated   Invoice[]         @relation(name: "InvoiceCreatedBy")
  invoicesUpdated   Invoice[]         @relation(name: "InvoiceUpdatedBy")
  payrollsCreated   PayrollRecord[]   @relation(name: "PayrollCreatedBy")
  payrollsUpdated   PayrollRecord[]   @relation(name: "PayrollUpdatedBy")
  driverRouteJoins  DriverRouteJoin[] @relation(name: "DriverRouteJoins")
  hosEntries        DriverHOSEntry[]  @relation(name: "DriverHOSEntries")
  incidents         DriverIncident[]  @relation(name: "DriverIncidents")
  pushTokens        PushToken[]

  // Carrier Operations reverse relations
  carrierDriverProfile CarrierDriver?      @relation(name: "CarrierDriverUser")
  dispatchedRuns       Trip[]              @relation(name: "TripDispatcher")
  uploadedCarrierDocs  CarrierDocument[]   @relation(name: "CarrierDocUploader")
  verifiedCarrierDocs  CarrierDocument[]   @relation(name: "CarrierDocVerifier")
  approvedExpenses     CarrierExpense[]    @relation(name: "CarrierExpenseApprover")
  approvedPayRecords   DriverPayRecord[]   @relation(name: "DriverPayApprover")
  inAppNotifications   InAppNotification[]

  // Notification System reverse relations
  notificationSubscriptions NotificationSubscription[]
  notificationPreferences   UserNotificationPreference[]

  // quick-329 PII audit log reverse relation
  auditLogs AuditLog[]

  // DataGrid saved views
  gridViews GridView[]

  // TKT-0015 Prompt 2a — audit FK reverse relations (Flag 4: Driver Pay)
  driverCompensationTemplatesCreatedBy DriverCompensationTemplate[] @relation(name: "DriverCompensationTemplateCreatedBy")
  loadDriverAssignmentsCreatedBy       LoadDriverAssignment[]       @relation(name: "LoadDriverAssignmentCreatedBy")
  loadPayComponentsCreatedBy           LoadPayComponent[]           @relation(name: "LoadPayComponentCreatedBy")
  driverBonusesCreatedBy               DriverBonus[]                @relation(name: "DriverBonusCreatedBy")
  driverDeductionsCreatedBy            DriverDeduction[]            @relation(name: "DriverDeductionCreatedBy")
  driverSettlementsCreatedBy           DriverSettlement[]           @relation(name: "DriverSettlementCreatedBy")
  driverDisputesCreatedBy              DriverDispute[]              @relation(name: "DriverDisputeCreatedBy")
  payComponentAttachmentsCreatedBy     PayComponentAttachment[]     @relation(name: "PayComponentAttachmentCreatedBy")

  // TKT-0015 Prompt 2a — audit FK reverse relations (Flag 8: bare UUID columns)
  playbookStepsCreatedBy               PlaybookStep[]               @relation(name: "PlaybookStepCreatedBy")
  stepInstancesCreatedBy               StepInstance[]               @relation(name: "StepInstanceCreatedBy")
  routeDriversCreatedBy                RouteDriver[]                @relation(name: "RouteDriverCreatedBy")
  pushTokensCreatedBy                  PushToken[]                  @relation(name: "PushTokenCreatedBy")
  userNotificationPreferencesCreatedBy UserNotificationPreference[] @relation(name: "UserNotificationPreferenceCreatedBy")
  sysAdminInvoiceItemsCreatedBy        SysAdminInvoiceItem[]        @relation(name: "SysAdminInvoiceItemCreatedBy")
  sysAdminInvoiceItemsUpdatedBy        SysAdminInvoiceItem[]        @relation(name: "SysAdminInvoiceItemUpdatedBy")

  // TKT-0015 Prompt 2b — Wave 1 reverse relations (Tag + ExpenseCategory)
  tagsCreated              Tag[]             @relation(name: "TagCreatedBy")
  tagsUpdated              Tag[]             @relation(name: "TagUpdatedBy")
  expenseCategoriesCreated ExpenseCategory[] @relation(name: "ExpenseCategoryCreatedBy")
  expenseCategoriesUpdated ExpenseCategory[] @relation(name: "ExpenseCategoryUpdatedBy")

  // TKT-0015 Prompt 2b — Wave 2 reverse relations (fleet domain)
  carrierClientsCreated    CarrierClient[]   @relation(name: "CarrierClientCreatedBy")
  carrierClientsUpdated    CarrierClient[]   @relation(name: "CarrierClientUpdatedBy")
  carrierClientsDeleted    CarrierClient[]   @relation(name: "CarrierClientDeletedBy")
  carrierContractsCreated  CarrierContract[] @relation(name: "CarrierContractCreatedBy")
  carrierContractsUpdated  CarrierContract[] @relation(name: "CarrierContractUpdatedBy")
  carrierContractsDeleted  CarrierContract[] @relation(name: "CarrierContractDeletedBy")
  carrierFacilitiesCreated CarrierFacility[] @relation(name: "CarrierFacilityCreatedBy")
  carrierFacilitiesUpdated CarrierFacility[] @relation(name: "CarrierFacilityUpdatedBy")
  carrierDriversCreated    CarrierDriver[]   @relation(name: "CarrierDriverCreatedBy")
  carrierDriversUpdated    CarrierDriver[]   @relation(name: "CarrierDriverUpdatedBy")
  carrierDriversDeleted    CarrierDriver[]   @relation(name: "CarrierDriverDeletedBy")
  carrierTrucksCreated     CarrierTruck[]    @relation(name: "CarrierTruckCreatedBy")
  carrierTrucksUpdated     CarrierTruck[]    @relation(name: "CarrierTruckUpdatedBy")
  carrierTrucksDeleted     CarrierTruck[]    @relation(name: "CarrierTruckDeletedBy")
  tripsCreated             Trip[]            @relation(name: "TripCreatedBy")
  tripsUpdated             Trip[]            @relation(name: "TripUpdatedBy")
  tripsDeleted             Trip[]            @relation(name: "TripDeletedBy")
  carrierLoadsCreated      CarrierLoad[]     @relation(name: "CarrierLoadCreatedBy")
  carrierLoadsUpdated      CarrierLoad[]     @relation(name: "CarrierLoadUpdatedBy")
  carrierLoadsDeleted      CarrierLoad[]     @relation(name: "CarrierLoadDeletedBy")
  carrierStopsCreated      CarrierStop[]     @relation(name: "CarrierStopCreatedBy")
  carrierStopsUpdated      CarrierStop[]     @relation(name: "CarrierStopUpdatedBy")
  carrierExpensesCreated   CarrierExpense[]  @relation(name: "CarrierExpenseCreatedBy")
  carrierExpensesUpdated   CarrierExpense[]  @relation(name: "CarrierExpenseUpdatedBy")
  documentsCreated         Document[]        @relation(name: "DocumentCreatedBy")
  documentsUpdated         Document[]        @relation(name: "DocumentUpdatedBy")
  fleetMessagesCreated     FleetMessage[]    @relation(name: "FleetMessageCreatedBy")

  // TKT-0015 Prompt 2b — Wave 3 reverse relations (finance/CRM/compliance)
  customersCreated            Customer[]            @relation(name: "CustomerCreatedBy")
  customersUpdated            Customer[]            @relation(name: "CustomerUpdatedBy")
  customerInteractionsCreated CustomerInteraction[] @relation(name: "CustomerInteractionCreatedBy")
  customerInteractionsUpdated CustomerInteraction[] @relation(name: "CustomerInteractionUpdatedBy")
  fuelRecordsCreated          FuelRecord[]          @relation(name: "FuelRecordCreatedBy")
  maintenanceEventsCreated    MaintenanceEvent[]    @relation(name: "MaintenanceEventCreatedBy")
  maintenanceEventsUpdated    MaintenanceEvent[]    @relation(name: "MaintenanceEventUpdatedBy")
  scheduledServicesCreated    ScheduledService[]    @relation(name: "ScheduledServiceCreatedBy")
  scheduledServicesUpdated    ScheduledService[]    @relation(name: "ScheduledServiceUpdatedBy")
  invoiceItemsCreated         InvoiceItem[]         @relation(name: "InvoiceItemCreatedBy")
  invoiceItemsUpdated         InvoiceItem[]         @relation(name: "InvoiceItemUpdatedBy")
  sysAdminInvoicesCreated     SysAdminInvoice[]     @relation(name: "SysAdminInvoiceCreatedBy")
  sysAdminInvoicesUpdated     SysAdminInvoice[]     @relation(name: "SysAdminInvoiceUpdatedBy")
  routeExpensesCreated        RouteExpense[]        @relation(name: "RouteExpenseCreatedBy")
  routeExpensesUpdated        RouteExpense[]        @relation(name: "RouteExpenseUpdatedBy")
  routePaymentsCreated        RoutePayment[]        @relation(name: "RoutePaymentCreatedBy")
  routePaymentsUpdated        RoutePayment[]        @relation(name: "RoutePaymentUpdatedBy")
  routeStopsCreated           RouteStop[]           @relation(name: "RouteStopCreatedBy")
  routeStopsUpdated           RouteStop[]           @relation(name: "RouteStopUpdatedBy")
  expenseTemplatesCreated     ExpenseTemplate[]     @relation(name: "ExpenseTemplateCreatedBy")
  expenseTemplatesUpdated     ExpenseTemplate[]     @relation(name: "ExpenseTemplateUpdatedBy")
  tenantIntegrationsCreated   TenantIntegration[]   @relation(name: "TenantIntegrationCreatedBy")
  tenantIntegrationsUpdated   TenantIntegration[]   @relation(name: "TenantIntegrationUpdatedBy")
  driverHOSEntriesCreated     DriverHOSEntry[]      @relation(name: "DriverHOSEntryCreatedBy")
  driverHOSEntriesUpdated     DriverHOSEntry[]      @relation(name: "DriverHOSEntryUpdatedBy")
  driverIncidentsCreated      DriverIncident[]      @relation(name: "DriverIncidentCreatedBy")
  driverIncidentsUpdated      DriverIncident[]      @relation(name: "DriverIncidentUpdatedBy")

  // Document Import reverse relations (Phase 1)
  documentImportsCreated        DocumentImport[]            @relation(name: "DocumentImportCreatedBy")
  documentImportsUpdated        DocumentImport[]            @relation(name: "DocumentImportUpdatedBy")
  documentImportsDeleted        DocumentImport[]            @relation(name: "DocumentImportDeletedBy")
  facilityExternalRefsConfirmed FacilityExternalReference[] @relation(name: "FacilityExternalRefConfirmedBy")
  tripInspectionsOverridden     Trip[]                      @relation(name: "TripInspectionOverriddenBy")

  // TKT-0015 Prompt 2b — Wave 4 reverse relations (driver pay + workflow + templates)
  driverInvitationsCreated           DriverInvitation[]           @relation(name: "DriverInvitationCreatedBy")
  driverInvitationsUpdated           DriverInvitation[]           @relation(name: "DriverInvitationUpdatedBy")
  supportTicketsCreated              SupportTicket[]              @relation(name: "SupportTicketCreatedBy")
  supportTicketsUpdated              SupportTicket[]              @relation(name: "SupportTicketUpdatedBy")
  playbooksCreated                   Playbook[]                   @relation(name: "PlaybookCreatedBy")
  playbooksUpdated                   Playbook[]                   @relation(name: "PlaybookUpdatedBy")
  playbookInstancesCreated           PlaybookInstance[]           @relation(name: "PlaybookInstanceCreatedBy")
  playbookInstancesUpdated           PlaybookInstance[]           @relation(name: "PlaybookInstanceUpdatedBy")
  playbookTriggersCreated            PlaybookTrigger[]            @relation(name: "PlaybookTriggerCreatedBy")
  playbookTriggersUpdated            PlaybookTrigger[]            @relation(name: "PlaybookTriggerUpdatedBy")
  stepTemplatesCreated               StepTemplate[]               @relation(name: "StepTemplateCreatedBy")
  stepTemplatesUpdated               StepTemplate[]               @relation(name: "StepTemplateUpdatedBy")
  routeTemplatesCreated              RouteTemplate[]              @relation(name: "RouteTemplateCreatedBy")
  routeTemplatesUpdated              RouteTemplate[]              @relation(name: "RouteTemplateUpdatedBy")
  routeTemplateStopsCreated          RouteTemplateStop[]          @relation(name: "RouteTemplateStopCreatedBy")
  driverCompensationTemplatesUpdated DriverCompensationTemplate[] @relation(name: "DriverCompensationTemplateUpdatedBy")
  loadDriverAssignmentsUpdated       LoadDriverAssignment[]       @relation(name: "LoadDriverAssignmentUpdatedBy")
  loadPayComponentsUpdated           LoadPayComponent[]           @relation(name: "LoadPayComponentUpdatedBy")
  payComponentAttachmentsUpdated     PayComponentAttachment[]     @relation(name: "PayComponentAttachmentUpdatedBy")
  driverBonusesUpdated               DriverBonus[]                @relation(name: "DriverBonusUpdatedBy")
  driverDeductionsUpdated            DriverDeduction[]            @relation(name: "DriverDeductionUpdatedBy")
  driverSettlementsUpdated           DriverSettlement[]           @relation(name: "DriverSettlementUpdatedBy")
  driverDisputesUpdated              DriverDispute[]              @relation(name: "DriverDisputeUpdatedBy")

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
  @@index([tenantId, role, isActive])
}

model Truck {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @db.Uuid
  make             String
  model            String
  year             Int
  vin              String
  licensePlate     String
  odometer         Int // Whole miles only (federal requirement)
  inMaintenance    Boolean   @default(false)
  documentMetadata Json? // JSONB: registration number, insurance expiry, etc.
  isDispatchReady  Boolean   @default(false)
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz
  archivedAt       DateTime? @db.Timestamptz
  isSample         Boolean   @default(false)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  createdBy         User?              @relation(name: "TruckCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?              @relation(name: "TruckUpdatedBy", fields: [updatedById], references: [id])
  assignedRoutes    Route[]
  documents         Document[]
  maintenanceEvents MaintenanceEvent[]
  scheduledServices ScheduledService[]
  gpsLocations      GPSLocation[]
  safetyEvents      SafetyEvent[]
  fuelRecords       FuelRecord[]
  tagAssignments    TagAssignment[]
  loads             Load[]

  @@unique([tenantId, vin])
  @@index([tenantId])
  @@index([archivedAt])
}

model DriverInvitation {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String           @db.Uuid
  email                   String
  firstName               String
  lastName                String
  licenseNumber           String?
  licenseNumberCiphertext Bytes?
  licenseNumberIv         Bytes?
  licenseNumberTag        Bytes?
  licenseNumberKeyId      String?
  licenseNumberLast4      String?          @db.VarChar(8)
  middleName              String?
  fullName                String?
  dateOfBirth             DateTime?        @db.Date
  dateOfBirthCiphertext   Bytes?
  dateOfBirthIv           Bytes?
  dateOfBirthTag          Bytes?
  dateOfBirthKeyId        String?
  dateOfBirthLast4        String?          @db.VarChar(8)
  phoneNumber             String?
  address                 String?
  licenseExpirationDate   DateTime?        @db.Date
  role                    UserRole         @default(DRIVER)
  permissions             Json?
  expiresAt               DateTime         @db.Timestamptz
  status                  InvitationStatus @default(PENDING)
  acceptedAt              DateTime?        @db.Timestamptz
  userId                  String?          @db.Uuid
  createdAt               DateTime         @default(now()) @db.Timestamptz
  updatedAt               DateTime         @updatedAt @db.Timestamptz
  createdById             String?          @db.Uuid
  updatedById             String?          @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User?  @relation(name: "DriverInvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation(name: "DriverInvitationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, status])
}

model Route {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @db.Uuid
  driverId       String      @db.Uuid
  truckId        String?     @db.Uuid
  carrierTruckId String?     @db.Uuid
  origin         String
  destination    String
  scheduledDate  DateTime    @db.Timestamptz
  status         RouteStatus @default(PLANNED)
  notes          String?
  name           String?
  completedAt    DateTime?   @db.Timestamptz
  version        Int         @default(1)
  startOdometer  Int?
  endOdometer    Int?
  distanceMiles  Float?
  createdById    String?     @db.Uuid
  updatedById    String?     @db.Uuid
  deletedAt      DateTime?   @db.Timestamptz
  deletedById    String?     @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @updatedAt @db.Timestamptz
  archivedAt     DateTime?   @db.Timestamptz

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  driver            User              @relation(fields: [driverId], references: [id])
  truck             Truck?            @relation(fields: [truckId], references: [id])
  carrierTruck      CarrierTruck?     @relation(fields: [carrierTruckId], references: [id])
  createdBy         User?             @relation(name: "RouteCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?             @relation(name: "RouteUpdatedBy", fields: [updatedById], references: [id])
  deletedBy         User?             @relation(name: "RouteDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  documents         Document[]
  safetyEvents      SafetyEvent[]
  expenses          RouteExpense[]
  payments          RoutePayment[]
  loads             Load[]
  stops             RouteStop[]
  coDrivers         RouteDriver[]
  driverAssignments DriverRouteJoin[]

  @@index([tenantId])
  @@index([driverId])
  @@index([truckId])
  @@index([carrierTruckId])
  @@index([scheduledDate])
  @@index([status])
  @@index([archivedAt])
  @@index([deletedAt])
  @@index([tenantId, driverId, scheduledDate])
}

model RouteDriver {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId   String    @db.Uuid
  driverId  String    @db.Uuid
  role      String    @default("co-driver")
  createdAt DateTime  @default(now()) @db.Timestamptz
  tenantId  String    @db.Uuid
  updatedAt DateTime? @db.Timestamptz
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime? @db.Timestamptz
  deletedBy String?   @db.Uuid

  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver  User   @relation(name: "RouteCoDrivers", fields: [driverId], references: [id])
  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator User?  @relation(name: "RouteDriverCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([routeId, driverId])
  @@index([routeId])
  @@index([driverId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model Document {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @db.Uuid
  truckId      String?       @db.Uuid
  routeId      String?       @db.Uuid
  driverId     String?       @db.Uuid
  loadId       String?       @db.Uuid
  fileName     String
  s3Key        String
  contentType  String
  sizeBytes    Int
  uploadedBy   String        @db.Uuid
  documentType DocumentType?
  isRestricted Boolean       @default(false) @map("is_restricted")
  expiryDate   DateTime?     @db.Timestamptz
  notes        String?
  description  String?       @db.Text
  externalUrl  String?
  createdById  String?       @db.Uuid // NEW (Wave 2)
  updatedById  String?       @db.Uuid // NEW (Wave 2)
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

