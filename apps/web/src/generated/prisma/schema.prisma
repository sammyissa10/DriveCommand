// ─── Document Import Models (Phase 1) ────────────────────────────────────────
// Spec: docs/specs/DocumentImport_TechnicalSpec_v1.md Sections 5, 6, 14, 15
// Audit: .planning/document-import/00-AUDIT.md
// Tenant column follows the carrier sibling convention: org_id (NOT tenantId).

/// One row per upload session. `reviewedExtraction` is what commits — edits live
/// there rather than in a normalised staging table, so resume-after-close works
/// for free (spec Section 6).
model DocumentImport {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  status String @default("UPLOADED")

  /// Ordered tenant-prefixed storage keys for the source files, as uploaded.
  sourceFileKeys String[] @default([]) @map("source_file_keys")
  sourceMimeType String?  @map("source_mime_type")
  originalName   String?  @map("original_name")

  /// SHA-256 over the concatenated source bytes. Half of the dedupe key.
  contentHash    String    @map("content_hash")
  documentNumber String?   @map("document_number")
  /// Date parsed out of the document, not the upload date. Spec 1.2 callout (3):
  /// a date can sit in a field labelled "Number", so this is deliberately separate.
  documentDate   DateTime? @map("document_date") @db.Date

  documentType String? @map("document_type")

  clientId          String? @map("client_id") @db.Uuid
  contractId        String? @map("contract_id") @db.Uuid
  routeTemplateId   String? @map("route_template_id") @db.Uuid
  documentProfileId String? @map("document_profile_id") @db.Uuid

  /// Model output, untouched. Holds third-party PII — subject to a retention
  /// window (spec Section 15); committed entities are the record of truth.
  rawExtraction      Json? @map("raw_extraction")
  /// Human-reviewed shape. THIS is what commits.
  reviewedExtraction Json? @map("reviewed_extraction")
  extractionWarnings Json  @default("[]") @map("extraction_warnings")

  modelIdentifier String?  @map("model_identifier")
  inputTokens     Int?     @map("input_tokens")
  outputTokens    Int?     @map("output_tokens")
  /// Money as Decimal, never float (spec Section 15).
  costUsd         Decimal? @map("cost_usd") @db.Decimal(10, 6)

  pageCount      Int?    @map("page_count")
  cachedPages    Int     @default(0) @map("cached_pages")
  failureCode    String? @map("failure_code")
  failureMessage String? @map("failure_message")

  /// Entity ids written by the commit transaction, for audit and rollback proof.
  createdTripId    String?   @map("created_trip_id") @db.Uuid
  createdEntityIds Json      @default("{}") @map("created_entity_ids")
  committedAt      DateTime? @map("committed_at") @db.Timestamptz

  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedById String?   @map("deleted_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant           @relation(fields: [orgId], references: [id])
  createdBy       User?            @relation(name: "DocumentImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation(name: "DocumentImportUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy       User?            @relation(name: "DocumentImportDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  client          CarrierClient?   @relation(fields: [clientId], references: [id])
  contract        CarrierContract? @relation(fields: [contractId], references: [id])
  routeTemplate   RouteTemplate?   @relation(fields: [routeTemplateId], references: [id])
  documentProfile DocumentProfile? @relation(fields: [documentProfileId], references: [id])

  extractedPages     DocumentImportPage[]
  externalReferences FacilityExternalReference[]
  sourcedTemplates   RouteTemplate[]             @relation(name: "RouteTemplateSourceImport")
  trips              Trip[]                      @relation(name: "TripSourceImport")

  @@index([orgId])
  @@index([status])
  @@index([clientId])
  @@index([deletedAt])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("document_imports")
}

/// Per-page extraction cache. Hashing each page independently means re-running a
/// 16-page manifest where one page was re-shot bills for one page (spec Section 14).
model DocumentImportPage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String @map("org_id") @db.Uuid
  importId String @map("import_id") @db.Uuid

  pageNumber Int     @map("page_number")
  pageHash   String  @map("page_hash")
  storageKey String? @map("storage_key")

  /// Null while pending; populated by the extractor or copied from a cache hit.
  extraction Json?
  wasCached  Boolean @default(false) @map("was_cached")

  modelIdentifier String? @map("model_identifier")
  inputTokens     Int?    @map("input_tokens")
  outputTokens    Int?    @map("output_tokens")

  failureCode    String? @map("failure_code")
  failureMessage String? @map("failure_message")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant         @relation(fields: [orgId], references: [id])
  import DocumentImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, pageNumber])
  @@index([orgId])
  @@index([importId])
  @@index([orgId, pageHash])
  @@map("document_import_pages")
}

/// The highest-value table in the module. "43775" is Dealer Tire's permanent id for
/// a dealership — confirm once, resolve silently forever (spec Sections 1.5, 7).
model FacilityExternalReference {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  clientId   String @map("client_id") @db.Uuid
  sourceCode String @map("source_code")
  facilityId String @map("facility_id") @db.Uuid

  /// How this link came to exist: T1/T2/T3/T4 of the resolution ladder.
  resolvedVia    String? @map("resolved_via")
  sourceImportId String? @map("source_import_id") @db.Uuid
  /// Name as it appeared on the document when confirmed — evidence for the "why"
  /// affordance (spec Section 4.2).
  sourceName     String? @map("source_name")

  confirmedById String?  @map("confirmed_by_id") @db.Uuid
  createdById   String?  @map("created_by_id") @db.Uuid
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant          @relation(fields: [orgId], references: [id])
  client       CarrierClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  facility     CarrierFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  sourceImport DocumentImport? @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  confirmedBy  User?           @relation(name: "FacilityExternalRefConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([orgId, clientId, sourceCode])
  @@index([orgId])
  @@index([clientId])
  @@index([facilityId])
  @@map("facility_external_references")
}

/// Per tenant + client + document type. Holds extraction hints, the saved
/// spreadsheet column mapping, and commit defaults (spec Section 6).
model DocumentProfile {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String @map("org_id") @db.Uuid
  clientId     String @map("client_id") @db.Uuid
  documentType String @map("document_type")

  name String?

  /// Free-form hints fed into the extraction prompt for this client's layout.
  extractionHints Json @default("{}") @map("extraction_hints")
  /// Saved header→canonical-path mapping for the spreadsheet path. Map once,
  /// reuse silently (spec Section 5).
  columnMapping   Json @default("{}") @map("column_mapping")

  commitStrategy       String? @map("commit_strategy")
  defaultEndStopPolicy String? @map("default_end_stop_policy")
  pinnedContractId     String? @map("pinned_contract_id") @db.Uuid

  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant           @relation(fields: [orgId], references: [id])
  client         CarrierClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pinnedContract CarrierContract? @relation(name: "DocumentProfilePinnedContract", fields: [pinnedContractId], references: [id], onDelete: SetNull)

  imports DocumentImport[]

  @@unique([orgId, clientId, documentType])
  @@index([orgId])
  @@index([clientId])
  @@map("document_profiles")
}

