  filename     String    @db.VarChar(255)
  contentType  String?   @map("content_type") @db.VarChar(100)
  sizeBytes    Int?      @map("size_bytes")
  uploadedBy   String    @map("uploaded_by") @db.Uuid
  // Standard tenant columns
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  component  LoadPayComponent     @relation(fields: [componentId], references: [id], onDelete: Restrict)
  assignment LoadDriverAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  creator    User?                @relation(name: "PayComponentAttachmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater    User?                @relation(name: "PayComponentAttachmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([componentId])
  @@index([assignmentId])
  @@map("pay_component_attachments")
}

model DriverDispute {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  driverId           String               @map("driver_id") @db.Uuid
  targetType         DisputeTargetType    @map("target_type")
  targetId           String               @map("target_id") @db.Uuid
  issueCategory      DisputeIssueCategory @map("issue_category")
  driverMessage      String               @map("driver_message")
  status             DisputeStatus        @default(OPEN)
  assignedTo         String?              @map("assigned_to") @db.Uuid
  resolutionMessage  String?              @map("resolution_message")
  resolvedAt         DateTime?            @map("resolved_at") @db.Timestamptz(6)
  linkedCorrectionId String?              @map("linked_correction_id") @db.Uuid
  // Standard tenant columns
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?              @map("created_by") @db.Uuid
  updatedBy          String?              @map("updated_by") @db.Uuid
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driver           CarrierDriver     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  linkedCorrection LoadPayComponent? @relation(fields: [linkedCorrectionId], references: [id], onDelete: Restrict)
  creator          User?             @relation(name: "DriverDisputeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater          User?             @relation(name: "DriverDisputeUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([driverId])
  @@index([tenantId, driverId])
  @@index([targetId])
  @@map("driver_disputes")
}

model DriverPayAuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String   @map("entity_id") @db.Uuid
  action        String   @db.VarChar(100)
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  actorId       String?  @map("actor_id") @db.Uuid
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  // Standard tenant columns (createdBy = actorId by convention for audit logs)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String   @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("driver_pay_audit_logs")
}

model DocFeedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  docSlug   String
  helpful   Boolean
  comment   String?
  createdAt DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([docSlug])
}

// ==============================================
// Notification System — Phase 41
// ==============================================

enum NotificationCategory {
  USER
  LOAD
  DRIVER
  TRUCK
  MESSAGE
  FINANCE
  ROUTE
  CUSTOMER
  DIGEST
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationSendStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DISABLED
  SKIPPED_USER_PREF
  SKIPPED_IDEMPOTENT
}

/// Global, system-level templates. No tenantId — owned by the platform.
model NotificationTemplate {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  triggerKey         String               @unique
  category           NotificationCategory
  displayName        String
  description        String               @db.Text
  defaultSubject     String
  defaultBlockJson   Json
  defaultHtmlCache   String?              @db.Text
  availableVariables Json
  defaultRecipients  Json
  isActive           Boolean              @default(true)
  inAppEnabled       Boolean              @default(true)
  createdAt          DateTime             @default(now()) @db.Timestamptz
  updatedAt          DateTime             @updatedAt @db.Timestamptz

  @@index([category])
  @@index([isActive])
}

/// Per-tenant overrides for each notification template. Auto-populated by trigger on Tenant insert.
model TenantNotificationSettings {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  triggerKey      String
  isActive        Boolean  @default(true)
  customSubject   String?
  customBlockJson Json?
  customHtmlCache String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, triggerKey])
  @@index([tenantId])
  @@index([triggerKey])
}

/// Users who subscribe to specific notification triggers within a tenant.
model NotificationSubscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  triggerKey String
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, triggerKey, userId])
  @@index([tenantId])
  @@index([userId])
}

/// Per-user channel preferences for each notification trigger.
model UserNotificationPreference {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  triggerKey   String
  emailEnabled Boolean   @default(true)
  inAppEnabled Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  tenantId     String    @db.Uuid
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid
  deletedAt    DateTime? @db.Timestamptz
  deletedBy    String?   @db.Uuid

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator User?  @relation(name: "UserNotificationPreferenceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([userId, triggerKey])
  @@index([userId])
  @@index([tenantId])
}

/// Audit log of every notification send attempt. No RLS — system-level audit.
model NotificationSendLog {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @db.Uuid
  triggerKey        String
  recipientUserId   String?                @db.Uuid
  recipientEmail    String?
  channel           NotificationChannel
  subject           String?                @db.Text
  status            NotificationSendStatus
  errorMessage      String?                @db.Text
  idempotencyKey    String
  relatedEntityType String?
  relatedEntityId   String?
  sentAt            DateTime?              @db.Timestamptz
  createdAt         DateTime               @default(now()) @db.Timestamptz
  updatedAt         DateTime               @updatedAt @db.Timestamptz

  @@index([tenantId])
  @@index([triggerKey])
  @@index([idempotencyKey])
  @@index([status])
  @@index([createdAt])
}

/// Single-row global email config. Enforced by a partial unique index in the migration.
model NotificationEmailConfig {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singletonKey String   @default("singleton")
  fromName     String
  fromEmail    String
  replyTo      String?
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz
}

/// Append-only audit log for PII access and restricted operations.
/// Tenant-scoped, FORCE RLS, REVOKE UPDATE/DELETE from app_user.
/// Part of DatabaseSecurity_MultiTenant_Spec_v1.md Section 4.4 (quick-329).
model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  fieldName    String?  @map("field_name")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([tenantId, resourceType, resourceId])
  @@map("audit_log")
}

/// User grid preferences for DataGrid columns, ordering, visibility, and density.
/// Not tenant-scoped — preferences are personal per user across all tenants they belong to.
model GridPreference {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  gridId        String   @db.VarChar(100)
  columnOrder   String[] @default([])
  columnWidths  Json     @default("{}")
  hiddenColumns String[] @default([])
  frozenColumns String[] @default([])
  density       String   @default("normal")
  pageSize      Int      @default(25)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  @@unique([userId, gridId])
  @@index([userId])
  @@map("grid_preference")
}

/// Saved grid views capturing complete grid state (filters, sort, columns, density).
/// Personal to user — not tenant-scoped.
model GridView {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gridId        String   @db.VarChar(100)
  userId        String   @db.Uuid
  name          String   @db.VarChar(100)
  isDefault     Boolean  @default(false)
  schemaVersion Int      @default(1)
  state         Json
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gridId, userId, name])
  @@index([gridId, userId])
  @@map("grid_view")
}
