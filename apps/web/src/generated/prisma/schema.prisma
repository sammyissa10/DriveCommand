  orgId                String    @map("org_id") @db.Uuid
  vehicleId            String    @unique @map("vehicle_id") @db.VarChar(50)
  displayName          String?   @map("display_name") @db.VarChar(200)
  unitNumber           String    @map("unit_number")
  year                 Int?
  make                 String?
  model                String?
  vin                  String?
  truckType            String    @default("semi") @map("truck_type")
  payloadCapacityLbs   Int?      @map("payload_capacity_lbs")
  grossWeightLbs       Int?      @map("gross_weight_lbs")
  licensePlate         String?   @map("license_plate")
  licenseState         String?   @map("license_state")
  licenseExpiry        DateTime? @map("license_expiry") @db.Date
  registrationExpiry   DateTime? @map("registration_expiry") @db.Date
  insuranceExpiry      DateTime? @map("insurance_expiry") @db.Date
  currentOdometerMiles Int?      @map("current_odometer_miles")
  lastOdometerDate     DateTime? @map("last_odometer_date") @db.Date
  status               String    @default("active")
  isSample             Boolean   @default(false) @map("is_sample")
  notes                String?
  photoS3Key           String?   @map("photo_s3_key")
  createdById          String?   @map("created_by_id") @db.Uuid // NEW (Wave 2)
  updatedById          String?   @map("updated_by_id") @db.Uuid // NEW (Wave 2)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz
  deletedById          String?   @map("deleted_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant                Tenant          @relation(fields: [orgId], references: [id])
  createdBy             User?           @relation(name: "CarrierTruckCreatedBy", fields: [createdById], references: [id], onDelete: SetNull) // NEW
  updatedBy             User?           @relation(name: "CarrierTruckUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull) // NEW
  deletedBy             User?           @relation(name: "CarrierTruckDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  primaryDispatches     Trip[]          @relation(name: "PrimaryTruck")
  trailerDispatches     Trip[]          @relation(name: "TrailerTruck")
  defaultRouteTemplates RouteTemplate[] @relation(name: "DefaultTruck")
  gpsLocations          GPSLocation[]
  routes                Route[]

  @@index([orgId])
  @@index([status])
  @@index([deletedAt])
  @@map("carrier_trucks")
}

model RouteTemplate {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                  String    @map("org_id") @db.Uuid
  templateName           String    @map("template_name")
  clientId               String    @map("client_id") @db.Uuid
  contractId             String?   @map("contract_id") @db.Uuid
  scheduleType           String    @map("schedule_type")
  recurrenceRule         String?   @map("recurrence_rule")
  recurrenceTimezone     String    @default("America/Chicago") @map("recurrence_timezone")
  scheduledDepartureTime String?   @map("scheduled_departure_time")
  equipmentType          String    @map("equipment_type")
  tempMinF               Int?      @map("temp_min_f")
  tempMaxF               Int?      @map("temp_max_f")
  maxWeightLbs           Int?      @map("max_weight_lbs")
  commodityDescription   String?   @map("commodity_description")
  estimatedMiles         Int?      @map("estimated_miles")
  defaultDriverId        String?   @map("default_driver_id") @db.Uuid
  defaultTruckId         String?   @map("default_truck_id") @db.Uuid
  autoGenerateDaysAhead  Int       @default(7) @map("auto_generate_days_ahead")
  active                 Boolean   @default(true)
  notes                  String?
  // ─── Document Import (Phase 1, spec Sections 6 + 8 + 9) ───────────────────
  // Overrides the tenant default; per-trip choice still wins over this.
  endStopPolicy          String?   @map("end_stop_policy")
  /// Set when a template was auto-created from a committed import. Such templates
  /// land in "Suggested templates" until a human confirms (spec Section 8).
  sourceImportId         String?   @map("source_import_id") @db.Uuid
  isSuggested            Boolean   @default(false) @map("is_suggested")
  lastAppliedAt          DateTime? @map("last_applied_at") @db.Timestamptz
  applicationCount       Int       @default(0) @map("application_count")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdById            String?   @map("created_by_id") @db.Uuid
  updatedById            String?   @map("updated_by_id") @db.Uuid

  tenant        Tenant              @relation(fields: [orgId], references: [id])
  client        CarrierClient       @relation(fields: [clientId], references: [id])
  contract      CarrierContract?    @relation(fields: [contractId], references: [id])
  defaultDriver CarrierDriver?      @relation(name: "DefaultDriver", fields: [defaultDriverId], references: [id])
  defaultTruck  CarrierTruck?       @relation(name: "DefaultTruck", fields: [defaultTruckId], references: [id])
  stops         RouteTemplateStop[]
  dispatches    Trip[]
  createdBy     User?               @relation(name: "RouteTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?               @relation(name: "RouteTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  sourceImport  DocumentImport?     @relation(name: "RouteTemplateSourceImport", fields: [sourceImportId], references: [id], onDelete: SetNull)

  matchedImports DocumentImport[]

  @@index([clientId])
  @@index([contractId])
  @@index([active])
  @@index([orgId])
  @@index([orgId, isSuggested])
  @@map("route_templates")
}

model RouteTemplateStop {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeTemplateId          String   @map("route_template_id") @db.Uuid
  sequenceOrder            Int      @map("sequence_order")
  stopType                 String   @map("stop_type")
  facilityId               String   @map("facility_id") @db.Uuid
  contactName              String?  @map("contact_name")
  contactPhone             String?  @map("contact_phone")
  apptWindowStartOffsetMin Int?     @map("appt_window_start_offset_min")
  apptWindowEndOffsetMin   Int?     @map("appt_window_end_offset_min")
  expectedDwellMinutes     Int?     @map("expected_dwell_minutes")
  commodityDescription     String?  @map("commodity_description")
  bolRequired              Boolean  @default(true) @map("bol_required")
  podRequired              Boolean  @default(true) @map("pod_required")
  specialInstructions      String?  @map("special_instructions")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdById              String?  @map("created_by_id") @db.Uuid

  routeTemplate RouteTemplate   @relation(fields: [routeTemplateId], references: [id], onDelete: Cascade)
  facility      CarrierFacility @relation(fields: [facilityId], references: [id])
  createdBy     User?           @relation(name: "RouteTemplateStopCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([routeTemplateId, sequenceOrder])
  @@index([routeTemplateId])
  @@map("route_template_stops")
}

model Trip {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                      String    @map("org_id") @db.Uuid
  routeTemplateId            String?   @map("route_template_id") @db.Uuid
  primaryDriverId            String    @map("primary_driver_id") @db.Uuid
  coDriverId                 String?   @map("co_driver_id") @db.Uuid
  truckId                    String    @map("truck_id") @db.Uuid
  trailerId                  String?   @map("trailer_id") @db.Uuid
  dispatcherId               String?   @map("dispatcher_id") @db.Uuid
  scheduledDeparture         DateTime  @map("scheduled_departure") @db.Timestamptz
  actualDeparture            DateTime? @map("actual_departure") @db.Timestamptz
  scheduledArrival           DateTime? @map("scheduled_arrival") @db.Timestamptz
  actualArrival              DateTime? @map("actual_arrival") @db.Timestamptz
  status                     String    @default("planned")
  // relay_handoff_stop_id is a plain UUID — NO FK (intentional: avoids circular reference dispatches→stops→dispatches)
  relayHandoffStopId         String?   @map("relay_handoff_stop_id") @db.Uuid
  plannedMiles               Decimal?  @map("planned_miles") @db.Decimal(10, 2)
  actualMiles                Decimal?  @map("actual_miles") @db.Decimal(10, 2)
  hosCycle                   String    @default("us_70") @map("hos_cycle")
  notes                      String?
  // ─── Document Import (Phase 1, spec Sections 6 + 9 + 12) ──────────────────
  sourceImportId             String?   @map("source_import_id") @db.Uuid
  endStopPolicy              String?   @map("end_stop_policy")
  /// Null means "fall back to the tenant setting"; a value is a per-trip override.
  inspectionRequired         Boolean?  @map("inspection_required")
  inspectionOverriddenById   String?   @map("inspection_overridden_by_id") @db.Uuid
  inspectionOverriddenReason String?   @map("inspection_overridden_reason")
  inspectionOverriddenAt     DateTime? @map("inspection_overridden_at") @db.Timestamptz
  createdById                String?   @map("created_by_id") @db.Uuid // NEW (Wave 2)
  updatedById                String?   @map("updated_by_id") @db.Uuid // NEW (Wave 2)
  deletedAt                  DateTime? @map("deleted_at") @db.Timestamptz
  deletedById                String?   @map("deleted_by_id") @db.Uuid
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant                 Tenant            @relation(fields: [orgId], references: [id])
  createdBy              User?             @relation(name: "TripCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?             @relation(name: "TripUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy              User?             @relation(name: "TripDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  routeTemplate          RouteTemplate?    @relation(fields: [routeTemplateId], references: [id])
  primaryDriver          CarrierDriver     @relation(name: "PrimaryDriver", fields: [primaryDriverId], references: [id])
  coDriver               CarrierDriver?    @relation(name: "CoDriver", fields: [coDriverId], references: [id])
  truck                  CarrierTruck      @relation(name: "PrimaryTruck", fields: [truckId], references: [id])
  trailer                CarrierTruck?     @relation(name: "TrailerTruck", fields: [trailerId], references: [id])
  dispatcher             User?             @relation(name: "TripDispatcher", fields: [dispatcherId], references: [id])
  sourceImport           DocumentImport?   @relation(name: "TripSourceImport", fields: [sourceImportId], references: [id], onDelete: SetNull)
  inspectionOverriddenBy User?             @relation(name: "TripInspectionOverriddenBy", fields: [inspectionOverriddenById], references: [id], onDelete: SetNull)
  stops                  CarrierStop[]
  carrierLoads           CarrierLoad[]
  expenses               CarrierExpense[]
  driverPayRecords       DriverPayRecord[]
  messages               FleetMessage[]
  documents              CarrierDocument[]

  @@index([primaryDriverId])
  @@index([truckId])
  @@index([status])
  @@index([scheduledDeparture])
  @@index([orgId])
  @@index([deletedAt])
  @@map("dispatches")
}

model CarrierLoad {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                String         @map("org_id") @db.Uuid
  dispatchId           String?        @map("dispatch_id") @db.Uuid
  contractId           String?        @map("contract_id") @db.Uuid
  clientId             String         @map("client_id") @db.Uuid
  loadType             String         @default("ftl") @map("load_type")
  referenceNumber      String?        @map("reference_number")
  bolNumber            String?        @map("bol_number")
  proNumber            String?        @map("pro_number")
  poNumber             String?        @map("po_number")
  commodityDescription String?        @map("commodity_description")
  commodityWeightLbs   Decimal?       @map("commodity_weight_lbs") @db.Decimal(10, 2)
  commodityPieces      Int?           @map("commodity_pieces")
  commodityPallets     Int?           @map("commodity_pallets")
  hazmat               Boolean        @default(false)
  hazmatClass          String?        @map("hazmat_class")
  rateType             String         @default("flat") @map("rate_type")
  rateAmount           Decimal?       @map("rate_amount") @db.Decimal(12, 2)
  currency             String         @default("USD")
  brokerFlag           Boolean        @default(false) @map("broker_flag")
  carrierCost          Decimal?       @map("carrier_cost") @db.Decimal(12, 2)
  fuelSurcharge        Decimal?       @map("fuel_surcharge") @db.Decimal(12, 2)
  detentionAmount      Decimal?       @map("detention_amount") @db.Decimal(12, 2)
  otherCharges         Decimal?       @map("other_charges") @db.Decimal(12, 2)
  totalRevenue         Decimal?       @map("total_revenue") @db.Decimal(12, 2)
  status               String         @default("pending")
  isSample             Boolean        @default(false) @map("is_sample")
  specialInstructions  String?        @map("special_instructions")
  notes                String?
  pendingStopsJson     String?        @map("pending_stops_json") @db.Text
  // Driver Pay additions (Phase 1)
  totalMiles           Decimal?       @map("total_miles") @db.Decimal(10, 2)
  loadedMiles          Decimal?       @map("loaded_miles") @db.Decimal(10, 2)
  mileageSource        MileageSource? @map("mileage_source")
  createdById          String?        @map("created_by_id") @db.Uuid // NEW (Wave 2)
  updatedById          String?        @map("updated_by_id") @db.Uuid // NEW (Wave 2)
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamptz
  deletedById          String?        @map("deleted_by_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant            @relation(fields: [orgId], references: [id])
  createdBy        User?             @relation(name: "CarrierLoadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull) // NEW
  updatedBy        User?             @relation(name: "CarrierLoadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull) // NEW
  deletedBy        User?             @relation(name: "CarrierLoadDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  dispatch         Trip?             @relation(fields: [dispatchId], references: [id])
  contract         CarrierContract?  @relation(fields: [contractId], references: [id])
  client           CarrierClient     @relation(fields: [clientId], references: [id])
  stops            CarrierStop[]
  expenses         CarrierExpense[]
  driverPayRecords DriverPayRecord[]
  documents        CarrierDocument[]

  // Driver Pay reverse relations
  driverAssignments LoadDriverAssignment[]
  payComponents     LoadPayComponent[]

  @@index([clientId])
  @@index([dispatchId])
  @@index([status])
  @@index([createdAt])
  @@index([orgId])
  @@index([deletedAt])
  @@map("loads")
}

model CarrierStop {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispatchId           String    @map("dispatch_id") @db.Uuid
  loadId               String?   @map("load_id") @db.Uuid
  sequenceOrder        Int       @map("sequence_order")
  stopType             String    @map("stop_type")
  facilityId           String    @map("facility_id") @db.Uuid
  clientId             String?   @map("client_id") @db.Uuid
  appointmentStart     DateTime? @map("appointment_start") @db.Timestamptz
  appointmentEnd       DateTime? @map("appointment_end") @db.Timestamptz
  arrivedAt            DateTime? @map("arrived_at") @db.Timestamptz
  departedAt           DateTime? @map("departed_at") @db.Timestamptz
  status               String    @default("pending")
  skipReason           String?   @map("skip_reason")
  commodityDescription String?   @map("commodity_description")
  pieces               Int?
  weightLbs            Decimal?  @map("weight_lbs") @db.Decimal(10, 2)
  bolNumber            String?   @map("bol_number")
  podNumber            String?   @map("pod_number")
  sealNumber           String?   @map("seal_number")
  bolRequired          Boolean   @default(true)
  podRequired          Boolean   @default(true)
  contactName          String?   @map("contact_name")
  contactPhone         String?   @map("contact_phone")
  specialInstructions  String?   @map("special_instructions")
  notes                String?
  // Driver Pay additions (Phase 1)
  freeTimeMinutes      Int       @default(120) @map("free_time_minutes")
  workState            String?   @map("work_state") @db.VarChar(2)
  // Workflow Engine checklist integration (quick-403)
  checklistStatus      String?   @map("checklist_status") // pending | in_progress | completed | deferred
  deferredReason       String?   @map("deferred_reason") // Why stop completion was deferred
  checklistEntityId    String?   @map("checklist_entity_id") @db.Uuid // FK to PlaybookInstance when workflow engine supports stops
  // ─── Document Import (Phase 1, spec Sections 6 + 10) ──────────────────────
  // JSONB rather than three child tables: this data is never queried relationally,
  // and the scalar bolNumber/podNumber/pieces/weightLbs fields above stay populated
  // in parallel so invoicing and reports keep working unchanged (audit B6).
  references           Json      @default("[]") // [{ type: SHIPMENT|PRO|ORDER|PO|BOL|LOAD|SEAL|OTHER, value }]
  lineItems            Json      @default("[]") @map("line_items") // [{ sku, description, quantity, uom, weight, hazmat }]
  pageNumbers          Json      @default("[]") @map("page_numbers") // source pages, so stop 5 opens page 4 not a 16-page scan
  /// True for the pinned final stop of the day (spec Section 9). Modelled as a flag
  /// because stops.stop_type is CHECK-constrained and has no "end" value (audit B5).
  isEndStop            Boolean   @default(false) @map("is_end_stop")
  /// Set when a rollup was hand-edited away from the computed line-item total,
  /// so the UI can mark it as overridden (spec Section 10).
  rollupOverridden     Boolean   @default(false) @map("rollup_overridden")
  createdById          String?   @map("created_by_id") @db.Uuid // NEW (Wave 2)
  updatedById          String?   @map("updated_by_id") @db.Uuid // NEW (Wave 2)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  dispatch  Trip              @relation(fields: [dispatchId], references: [id])
  createdBy User?             @relation(name: "CarrierStopCreatedBy", fields: [createdById], references: [id], onDelete: SetNull) // NEW
  updatedBy User?             @relation(name: "CarrierStopUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull) // NEW
  load      CarrierLoad?      @relation(fields: [loadId], references: [id])
  facility  CarrierFacility   @relation(fields: [facilityId], references: [id])
  client    CarrierClient?    @relation(fields: [clientId], references: [id])
  documents CarrierDocument[]
  expenses  CarrierExpense[]
  messages  FleetMessage[]

  @@unique([dispatchId, sequenceOrder])
  @@index([dispatchId])
  @@index([loadId])
  @@index([clientId])
  @@index([status])
  @@index([dispatchId, sequenceOrder])
  @@map("stops")
}

model CarrierDocument {
