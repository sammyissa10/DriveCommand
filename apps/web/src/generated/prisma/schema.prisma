// ─── Multi-Stop Route Models ─────────────────────────────────

model RouteStop {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId      String          @db.Uuid
  tenantId     String          @db.Uuid
