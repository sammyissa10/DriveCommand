// ─── Carrier Operations Models ───────────────────────────────────────────────
// All carrier models use orgId (maps to org_id in SQL) for tenant scoping.
// Model names are prefixed to avoid conflicts with existing models
// (Load, Document, Truck already exist in this schema).

model CarrierClient {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  name           String
  dbaName        String?   @map("dba_name")
  mcNumber       String?   @map("mc_number")
  dotNumber      String?   @map("dot_number")
  taxId          String?   @map("tax_id")
  primaryContact String?   @map("primary_contact")
  email          String?
  phone          String?
  website        String?
  addressLine1   String?   @map("address_line1")
  addressLine2   String?   @map("address_line2")
  city           String?
  state          String?
  zip            String?
  country        String    @default("US")
  status         String    @default("active")
  isSample       Boolean   @default(false) @map("is_sample")
  portalAccess   Boolean   @default(false) @map("portal_access")
  portalEmail    String?   @map("portal_email")
  paymentTerms   Int       @default(30) @map("payment_terms")
  creditLimit    Decimal?  @map("credit_limit") @db.Decimal(12, 2)
  notes          String?
  createdById    String?   @map("created_by_id") @db.Uuid // NEW (Wave 2)
  updatedById    String?   @map("updated_by_id") @db.Uuid // NEW (Wave 2)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedById    String?   @map("deleted_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant                 @relation(fields: [orgId], references: [id])
  createdBy        User?                  @relation(name: "CarrierClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull) // NEW
  updatedBy        User?                  @relation(name: "CarrierClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull) // NEW
  deletedBy        User?                  @relation(name: "CarrierClientDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  contracts        CarrierContract[]
  routeTemplates   RouteTemplate[]
  stops            CarrierStop[]
  carrierDocuments CarrierDocument[]
  expenses         CarrierExpense[]
  driverPayRecords DriverPayRecord[]
  carrierLoads     CarrierLoad[]
  contacts         CarrierClientContact[]

  // Document Import (Phase 1)
  documentImports    DocumentImport[]
  externalReferences FacilityExternalReference[]
  documentProfiles   DocumentProfile[]

  @@index([orgId])
  @@index([status])
  @@index([deletedAt])
  @@map("clients")
}

