// Workflow Engine Models

model StepTemplate {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @db.Uuid
  name          String       @db.VarChar(200)
  description   String?
  stepType      StepType
  assigneeRole  AssigneeRole
  defaultConfig Json         @default("{}")
  isActive      Boolean      @default(true)
  deletedAt     DateTime?    @db.Timestamptz
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz
  createdById   String?      @db.Uuid
  updatedById   String?      @db.Uuid

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playbookSteps PlaybookStep[]
  stepInstances StepInstance[]
  createdBy     User?          @relation(name: "StepTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation(name: "StepTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId, isActive])
  @@index([tenantId, stepType])
}

model Playbook {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @db.Uuid
  name          String             @db.VarChar(200)
  description   String?
  entityType    PlaybookEntityType
  category      PlaybookCategory
  playbookPhase PhaseType          @default(NONE)
  isActive      Boolean            @default(true)
  deletedAt     DateTime?          @db.Timestamptz
  createdAt     DateTime           @default(now()) @db.Timestamptz
  updatedAt     DateTime           @updatedAt @db.Timestamptz
  createdById   String?            @db.Uuid
  updatedById   String?            @db.Uuid

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps     PlaybookStep[]
  instances PlaybookInstance[]
  triggers  PlaybookTrigger[]
  createdBy User?              @relation(name: "PlaybookCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?              @relation(name: "PlaybookUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId, isActive])
  @@index([tenantId, entityType])
}

model PlaybookStep {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playbookId        String           @db.Uuid
  stepTemplateId    String           @db.Uuid
  sequence          Int
  playbookPhase     PhaseType        @default(NONE)
  overrideConfig    Json             @default("{}")
  isRequired        Boolean          @default(true)
  isDispatchBlocker Boolean          @default(false)
  dueDaysFromStart  Int?
  dueWithinHours    Int? // SLA in hours (e.g. 24). If null, cron skips this step.
  overdueRecipient  OverdueRecipient @default(OWNER) // Who gets the overdue push notification
  dueBeforeDispatch Boolean          @default(false)
  createdAt         DateTime         @default(now()) @db.Timestamptz
  updatedAt         DateTime         @updatedAt @db.Timestamptz
  tenantId          String           @db.Uuid
  createdBy         String?          @db.Uuid
  updatedBy         String?          @db.Uuid
  deletedAt         DateTime?        @db.Timestamptz
  deletedBy         String?          @db.Uuid

  playbook     Playbook     @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  stepTemplate StepTemplate @relation(fields: [stepTemplateId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator      User?        @relation(name: "PlaybookStepCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([playbookId, sequence])
  @@index([playbookId])
  @@index([stepTemplateId])
  @@index([tenantId])
}

model PlaybookInstance {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String             @db.Uuid
  playbookId        String             @db.Uuid
  playbookSnapshot  Json
  entityType        PlaybookEntityType
  entityId          String             @db.Uuid
  status            InstanceStatus     @default(NOT_STARTED)
  completionPercent Float              @default(0)
  isDispatchReady   Boolean            @default(false)
  startedAt         DateTime?          @db.Timestamptz
  completedAt       DateTime?          @db.Timestamptz
  dueDate           DateTime?          @db.Timestamptz
  triggeredBy       String? // 'manual' | 'trigger' — null for legacy rows
  triggeredEvent    TriggerEvent? // Set when triggeredBy='trigger', e.g. ON_DRIVER_CREATE
  createdAt         DateTime           @default(now()) @db.Timestamptz
  updatedAt         DateTime           @updatedAt @db.Timestamptz
  createdById       String?            @db.Uuid
  updatedById       String?            @db.Uuid

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playbook      Playbook               @relation(fields: [playbookId], references: [id], onDelete: Restrict)
  stepInstances StepInstance[]
  notifications PlaybookNotification[]
  createdBy     User?                  @relation(name: "PlaybookInstanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                  @relation(name: "PlaybookInstanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status])
  @@index([tenantId, isDispatchReady])
  @@index([tenantId, triggeredBy, createdAt(sort: Desc)])
}

model StepInstance {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playbookInstanceId String       @db.Uuid
  stepTemplateId     String?      @db.Uuid
  stepSnapshot       Json
  status             StepStatus   @default(NOT_STARTED)
