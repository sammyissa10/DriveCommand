model CarrierFacility {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  name                String
  facilityType        String   @default("terminal") @map("facility_type")
  addressLine1        String?  @map("address_line1")
  addressLine2        String?  @map("address_line2")
  city                String?
  state               String?
  zip                 String?
  country             String   @default("US")
  latitude            Float?
  longitude           Float?
  contactName         String?  @map("contact_name")
  contactPhone        String?  @map("contact_phone")
  contactEmail        String?  @map("contact_email")
  lumperRequired      Boolean  @default(false) @map("lumper_required")
  appointmentRequired Boolean  @default(false) @map("appointment_required")
  contacts            Json     @default("[]")
  notes               String?
  // ─── Document Import (Phase 1, spec Sections 6 + 9) ───────────────────────
  // A driver residence is visible only to that driver, the owner, and dispatchers
  // with explicit permission — enforced server-side, never as a UI hide (Section 9).
  isDriverResidence   Boolean  @default(false) @map("is_driver_residence")
  residentDriverId    String?  @map("resident_driver_id") @db.Uuid
  createdById         String?  @map("created_by_id") @db.Uuid // NEW (Wave 2)
  updatedById         String?  @map("updated_by_id") @db.Uuid // NEW (Wave 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant              @relation(fields: [orgId], references: [id])
  createdBy          User?               @relation(name: "CarrierFacilityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull) // NEW
  updatedBy          User?               @relation(name: "CarrierFacilityUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull) // NEW
  residentDriver     CarrierDriver?      @relation(name: "FacilityResidentDriver", fields: [residentDriverId], references: [id], onDelete: SetNull)
  carrierDrivers     CarrierDriver[]
  routeTemplateStops RouteTemplateStop[]
  stops              CarrierStop[]

  externalReferences FacilityExternalReference[]
  homeBaseForTenants Tenant[]                    @relation(name: "TenantHomeBase")

  @@index([orgId])
  @@index([facilityType])
  @@index([orgId, isDriverResidence])
  @@map("facilities")
}

model CarrierDriver {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  userId              String?   @unique @map("user_id") @db.Uuid
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  email               String?
  phone               String?
  cdlNumber           String?   @map("cdl_number")
  cdlNumberCiphertext Bytes?    @map("cdl_number_ciphertext")
  cdlNumberIv         Bytes?    @map("cdl_number_iv")
  cdlNumberTag        Bytes?    @map("cdl_number_tag")
  cdlNumberKeyId      String?   @map("cdl_number_key_id")
  cdlNumberLast4      String?   @map("cdl_number_last4") @db.VarChar(4)
  cdlState            String?   @map("cdl_state")
  cdlClass            String?   @map("cdl_class")
  cdlExpiry           DateTime? @map("cdl_expiry") @db.Date
  homeTerminalId      String?   @map("home_terminal_id") @db.Uuid
  payModel            String    @default("per_mile") @map("pay_model")
  payRate             Decimal?  @map("pay_rate") @db.Decimal(10, 4)
  payPeriod           String    @default("weekly") @map("pay_period")
  status              String    @default("active")
  isSample            Boolean   @default(false) @map("is_sample")
  notes               String?
  createdById         String?   @map("created_by_id") @db.Uuid // NEW (Wave 2)
  updatedById         String?   @map("updated_by_id") @db.Uuid // NEW (Wave 2)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  deletedById         String?   @map("deleted_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant                Tenant            @relation(fields: [orgId], references: [id])
  createdBy             User?             @relation(name: "CarrierDriverCreatedBy", fields: [createdById], references: [id], onDelete: SetNull) // NEW
  updatedBy             User?             @relation(name: "CarrierDriverUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull) // NEW
  deletedBy             User?             @relation(name: "CarrierDriverDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  user                  User?             @relation(name: "CarrierDriverUser", fields: [userId], references: [id])
  homeTerminal          CarrierFacility?  @relation(fields: [homeTerminalId], references: [id])
  primaryDispatches     Trip[]            @relation(name: "PrimaryDriver")
  coDispatches          Trip[]            @relation(name: "CoDriver")
  expenses              CarrierExpense[]
  driverPayRecords      DriverPayRecord[]
  defaultRouteTemplates RouteTemplate[]   @relation(name: "DefaultDriver")

  // Driver Pay reverse relations
  compensationTemplates DriverCompensationTemplate[]
  loadAssignments       LoadDriverAssignment[]
  driverBonuses         DriverBonus[]
  referredBonuses       DriverBonus[]                @relation("BonusReferredDriver")
  driverDeductions      DriverDeduction[]
  driverSettlements     DriverSettlement[]
  driverDisputes        DriverDispute[]

  // Document Import (Phase 1) — driver residence facility, spec Section 9
  residenceFacilities CarrierFacility[] @relation(name: "FacilityResidentDriver")

  @@index([orgId])
  @@index([status])
  @@index([deletedAt])
  @@map("carrier_drivers")
}

