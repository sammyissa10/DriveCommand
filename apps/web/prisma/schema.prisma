// ─── Carrier Operations Models ───────────────────────────────────────────────
// All carrier models use orgId (maps to org_id in SQL) for tenant scoping.
// Model names are prefixed to avoid conflicts with existing models
// (Load, Document, Truck already exist in this schema).

model CarrierClient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  name           String
  dbaName        String?  @map("dba_name")
  mcNumber       String?  @map("mc_number")
  dotNumber      String?  @map("dot_number")
  taxId          String?  @map("tax_id")
  primaryContact String?  @map("primary_contact")
  email          String?
  phone          String?
  website        String?
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  state          String?
  zip            String?
  country        String   @default("US")
  status         String   @default("active")
  portalAccess   Boolean  @default(false) @map("portal_access")
  portalEmail    String?  @map("portal_email")
  paymentTerms   Int      @default(30) @map("payment_terms")
  creditLimit    Decimal? @map("credit_limit") @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant            @relation(fields: [orgId], references: [id])
  contracts        CarrierContract[]
  routeTemplates   RouteTemplate[]
  stops            CarrierStop[]
  carrierDocuments CarrierDocument[]
  expenses         CarrierExpense[]
  driverPayRecords DriverPayRecord[]
  carrierLoads     CarrierLoad[]

  @@index([orgId])
  @@index([status])
  @@map("clients")
}

model CarrierContract {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                String    @map("org_id") @db.Uuid
  clientId             String    @map("client_id") @db.Uuid
  contractNumber       String    @unique @map("contract_number")
  contractName         String?   @map("contract_name")
  contractType         String    @default("spot") @map("contract_type")
  effectiveDate        DateTime? @map("effective_date") @db.Date
  expirationDate       DateTime? @map("expiration_date") @db.Date
  rateType             String    @default("per_mile") @map("rate_type")
  baseRate             Decimal?  @map("base_rate") @db.Decimal(10, 4)
  fuelSurchargeMethod  String    @default("none") @map("fuel_surcharge_method")
  fuelSurchargeRate    Decimal?  @map("fuel_surcharge_rate") @db.Decimal(6, 4)
  detentionFreeMinutes Int       @default(120) @map("detention_free_minutes")
  detentionRatePerHour Decimal?  @map("detention_rate_per_hour") @db.Decimal(10, 2)
  tonuRate             Decimal?  @map("tonu_rate") @db.Decimal(10, 2)
  layoverRatePerDay    Decimal?  @map("layover_rate_per_day") @db.Decimal(10, 2)
  paymentTermsOverride String?   @map("payment_terms_override")
  autoRenew            Boolean   @default(false) @map("auto_renew")
  status               String    @default("active")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant            @relation(fields: [orgId], references: [id])
  client         CarrierClient     @relation(fields: [clientId], references: [id])
  routeTemplates RouteTemplate[]
  carrierLoads   CarrierLoad[]
  documents      CarrierDocument[]

  @@index([clientId])
  @@index([status])
  @@index([orgId])
  @@map("contracts")
}

model CarrierFacility {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  name                String
  facilityType        String   @default("terminal") @map("facility_type")
  addressLine1        String?  @map("address_line1")
  addressLine2        String?  @map("address_line2")
  city                String?
  state               String?
  zip                 String?
  country             String   @default("US")
  latitude            Float?
  longitude           Float?
  contactName         String?  @map("contact_name")
  contactPhone        String?  @map("contact_phone")
  contactEmail        String?  @map("contact_email")
  lumperRequired      Boolean  @default(false) @map("lumper_required")
  appointmentRequired Boolean  @default(false) @map("appointment_required")
  contacts            Json     @default("[]")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant              @relation(fields: [orgId], references: [id])
  carrierDrivers     CarrierDriver[]
  routeTemplateStops RouteTemplateStop[]
  stops              CarrierStop[]

  @@index([orgId])
  @@index([facilityType])
  @@map("facilities")
}

model CarrierDriver {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String?
  phone          String?
  cdlNumber      String?   @map("cdl_number")
