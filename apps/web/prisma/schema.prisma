// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  OWNER
  MANAGER
  DRIVER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum SafetyEventType {
  HARSH_BRAKING
  HARSH_ACCELERATION
  HARSH_CORNERING
  SPEEDING
  DISTRACTED_DRIVING
  ROLLING_STOP
  SEATBELT_VIOLATION
  FOLLOWING_TOO_CLOSE
}

enum SafetyEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FuelType {
  DIESEL
  GASOLINE
  ELECTRIC
  HYBRID
  CNG
  LPG
}

enum PaymentStatus {
  PENDING
  PAID
}

enum DocumentType {
  DRIVER_LICENSE
  DRIVER_APPLICATION
  GENERAL
  RATE_CONFIRMATION
}

enum IntegrationProvider {
  QUICKBOOKS
  SAMSARA
  KEEP_TRUCKIN
  TRIUMPH_FACTORING
  OTR_SOLUTIONS
  SENDGRID
  MAILGUN
}

enum IntegrationCategory {
  ACCOUNTING
  ELD
  FACTORING
  EMAIL
}

enum RouteStopType {
  PICKUP
  DELIVERY
}

enum RouteStopStatus {
  PENDING
  ARRIVED
  DEPARTED
}

enum InAppNotificationType {
  dispatch_assigned
  load_delivered
  pay_record_ready
  invoice_generated
  compliance_alert
  stop_completed
  needs_assignment
  dispatch_generated
  fleet_message
}

// Models
model Tenant {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String?  @unique
  timezone              String   @default("UTC")
  contactEmail          String?
  plan                  String   @default("starter")
  isActive              Boolean  @default(true)
  profitMarginThreshold Decimal  @default(10) @db.Decimal(5, 2)
  createdAt             DateTime @default(now()) @db.Timestamptz
  updatedAt             DateTime @updatedAt @db.Timestamptz

  users                User[]
  trucks               Truck[]
  driverInvitations    DriverInvitation[]
  routes               Route[]
  documents            Document[]
  maintenanceEvents    MaintenanceEvent[]
  scheduledServices    ScheduledService[]
  notificationLogs     NotificationLog[]
  gpsLocations         GPSLocation[]
  safetyEvents         SafetyEvent[]
  fuelRecords          FuelRecord[]
  tags                 Tag[]
  tagAssignments       TagAssignment[]
  expenseCategories    ExpenseCategory[]
  expenseTemplates     ExpenseTemplate[]
  routeExpenses        RouteExpense[]
  routePayments        RoutePayment[]
  customers            Customer[]
  customerInteractions CustomerInteraction[]
  invoices             Invoice[]
  invoiceItems         InvoiceItem[]
  payrollRecords       PayrollRecord[]
  expenseTemplateItems ExpenseTemplateItem[]
  loads                Load[]
  tenantIntegrations   TenantIntegration[]
  routeStops           RouteStop[]
  sysAdminInvoices     SysAdminInvoice[]
  driverRouteJoins     DriverRouteJoin[]
  driverHOSEntries     DriverHOSEntry[]
  driverIncidents      DriverIncident[]

  // Carrier Operations reverse relations
  carrierClients       CarrierClient[]
  carrierContracts     CarrierContract[]
  carrierFacilities    CarrierFacility[]
  carrierDrivers       CarrierDriver[]
  carrierTrucks        CarrierTruck[]
  routeTemplates       RouteTemplate[]
  carrierDispatches    CarrierDispatch[]
  carrierLoads         CarrierLoad[]
  carrierExpenses      CarrierExpense[]
  driverPayRecords     DriverPayRecord[]
  inAppNotifications   InAppNotification[]
  carrierDocumentTypes CarrierDocumentType[]

  // Workflow Engine reverse relations
  stepTemplates          StepTemplate[]
  playbooks              Playbook[]
  playbookInstances      PlaybookInstance[]
  playbookNotifications  PlaybookNotification[]
  playbookTriggers       PlaybookTrigger[]
  dispatchOverrideAudits DispatchOverrideAudit[]
}

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  email           String
  passwordHash    String?
  role            UserRole
  isSystemAdmin   Boolean  @default(false)
  firstName       String?
  lastName        String?
  licenseNumber   String?
  isActive        Boolean  @default(true)
  permissions     Json?
  isDispatchReady Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  assignedRoutes    Route[]
  uploadedDocuments Document[]
  driverDocuments   Document[]        @relation(name: "DriverDocuments")
  safetyEvents      SafetyEvent[]
  tagAssignments    TagAssignment[]
  payrollRecords    PayrollRecord[]
  driverLoads       Load[]            @relation(name: "DriverLoads")
  routeCoDrivers    RouteDriver[]     @relation(name: "RouteCoDrivers")
  trucksCreated     Truck[]           @relation(name: "TruckCreatedBy")
  trucksUpdated     Truck[]           @relation(name: "TruckUpdatedBy")
  routesCreated     Route[]           @relation(name: "RouteCreatedBy")
  routesUpdated     Route[]           @relation(name: "RouteUpdatedBy")
  loadsCreated      Load[]            @relation(name: "LoadCreatedBy")
  loadsUpdated      Load[]            @relation(name: "LoadUpdatedBy")
  invoicesCreated   Invoice[]         @relation(name: "InvoiceCreatedBy")
  invoicesUpdated   Invoice[]         @relation(name: "InvoiceUpdatedBy")
  payrollsCreated   PayrollRecord[]   @relation(name: "PayrollCreatedBy")
  payrollsUpdated   PayrollRecord[]   @relation(name: "PayrollUpdatedBy")
  driverRouteJoins  DriverRouteJoin[] @relation(name: "DriverRouteJoins")
  hosEntries        DriverHOSEntry[]  @relation(name: "DriverHOSEntries")
  incidents         DriverIncident[]  @relation(name: "DriverIncidents")
  pushTokens        PushToken[]

  // Carrier Operations reverse relations
  carrierDriverProfile CarrierDriver?      @relation(name: "CarrierDriverUser")
  dispatchedRuns       CarrierDispatch[]   @relation(name: "CarrierDispatcher")
  uploadedCarrierDocs  CarrierDocument[]   @relation(name: "CarrierDocUploader")
  verifiedCarrierDocs  CarrierDocument[]   @relation(name: "CarrierDocVerifier")
  approvedExpenses     CarrierExpense[]    @relation(name: "CarrierExpenseApprover")
  approvedPayRecords   DriverPayRecord[]   @relation(name: "DriverPayApprover")
  inAppNotifications   InAppNotification[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
  @@index([tenantId, role, isActive])
}

model Truck {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @db.Uuid
  make             String
  model            String
  year             Int
  vin              String
  licensePlate     String
  odometer         Int // Whole miles only (federal requirement)
  inMaintenance    Boolean   @default(false)
  documentMetadata Json? // JSONB: registration number, insurance expiry, etc.
  isDispatchReady  Boolean   @default(false)
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz
  archivedAt       DateTime? @db.Timestamptz

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  createdBy         User?              @relation(name: "TruckCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?              @relation(name: "TruckUpdatedBy", fields: [updatedById], references: [id])
  assignedRoutes    Route[]
  documents         Document[]
  maintenanceEvents MaintenanceEvent[]
  scheduledServices ScheduledService[]
  gpsLocations      GPSLocation[]
  safetyEvents      SafetyEvent[]
  fuelRecords       FuelRecord[]
  tagAssignments    TagAssignment[]
  loads             Load[]

  @@unique([tenantId, vin])
  @@index([tenantId])
  @@index([archivedAt])
}

model DriverInvitation {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String           @db.Uuid
  email                 String
  firstName             String
  lastName              String
  licenseNumber         String?
  middleName            String?
  fullName              String?
  dateOfBirth           DateTime?        @db.Date
  phoneNumber           String?
  address               String?
  licenseExpirationDate DateTime?        @db.Date
  role                  UserRole         @default(DRIVER)
  permissions           Json?
  expiresAt             DateTime         @db.Timestamptz
  status                InvitationStatus @default(PENDING)
  acceptedAt            DateTime?        @db.Timestamptz
  userId                String?          @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz
  updatedAt             DateTime         @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, status])
}

model Route {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @db.Uuid
  driverId      String      @db.Uuid
  truckId       String      @db.Uuid
  origin        String
  destination   String
  scheduledDate DateTime    @db.Timestamptz
  status        RouteStatus @default(PLANNED)
  notes         String?
  name          String?
  completedAt   DateTime?   @db.Timestamptz
  version       Int         @default(1)
  startOdometer Int?
  endOdometer   Int?
  distanceMiles Float?
  createdById   String?     @db.Uuid
  updatedById   String?     @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz
  archivedAt    DateTime?   @db.Timestamptz

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  driver            User              @relation(fields: [driverId], references: [id])
  truck             Truck             @relation(fields: [truckId], references: [id])
  createdBy         User?             @relation(name: "RouteCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?             @relation(name: "RouteUpdatedBy", fields: [updatedById], references: [id])
  documents         Document[]
  safetyEvents      SafetyEvent[]
  expenses          RouteExpense[]
  payments          RoutePayment[]
  loads             Load[]
  stops             RouteStop[]
  coDrivers         RouteDriver[]
  driverAssignments DriverRouteJoin[]

  @@index([tenantId])
  @@index([driverId])
  @@index([truckId])
  @@index([scheduledDate])
  @@index([status])
  @@index([archivedAt])
  @@index([tenantId, driverId, scheduledDate])
}

model RouteDriver {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId   String   @db.Uuid
  driverId  String   @db.Uuid
  role      String   @default("co-driver")
  createdAt DateTime @default(now()) @db.Timestamptz

  route  Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver User  @relation(name: "RouteCoDrivers", fields: [driverId], references: [id])

  @@unique([routeId, driverId])
  @@index([routeId])
  @@index([driverId])
}

model Document {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @db.Uuid
  truckId      String?       @db.Uuid
  routeId      String?       @db.Uuid
  driverId     String?       @db.Uuid
  loadId       String?       @db.Uuid
  fileName     String
  s3Key        String
  contentType  String
  sizeBytes    Int
  uploadedBy   String        @db.Uuid
  documentType DocumentType?
  expiryDate   DateTime?     @db.Timestamptz
  notes        String?
  description  String?       @db.Text
  externalUrl  String?
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  truck    Truck? @relation(fields: [truckId], references: [id])
  route    Route? @relation(fields: [routeId], references: [id])
  driver   User?  @relation(name: "DriverDocuments", fields: [driverId], references: [id])
  load     Load?  @relation(fields: [loadId], references: [id])
  uploader User   @relation(fields: [uploadedBy], references: [id])

  @@index([tenantId])
  @@index([truckId])
  @@index([routeId])
  @@index([driverId])
  @@index([loadId])
  @@index([expiryDate])
  @@index([uploadedBy])
  @@index([tenantId, driverId])
}

model MaintenanceEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @db.Uuid
  truckId           String   @db.Uuid
  serviceType       String
  serviceDate       DateTime @db.Timestamptz
  odometerAtService Int
  cost              Decimal? @db.Decimal(10, 2)
  provider          String?
  notes             String?
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  truck  Truck  @relation(fields: [truckId], references: [id])

  @@index([tenantId])
  @@index([truckId])
  @@index([serviceDate])
}

model ScheduledService {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @db.Uuid
  truckId          String    @db.Uuid
  serviceType      String
  intervalDays     Int?
  intervalMiles    Int?
  baselineDate     DateTime  @db.Timestamptz
  baselineOdometer Int
  notes            String?
  isCompleted      Boolean   @default(false)
  completedAt      DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  truck  Truck  @relation(fields: [truckId], references: [id])

  @@index([tenantId])
  @@index([truckId])
  @@index([isCompleted])
}

model NotificationLog {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @db.Uuid
  idempotencyKey   String             @unique
  notificationType String
  entityType       String?
  entityId         String?            @db.Uuid
  recipientEmail   String
  status           NotificationStatus @default(PENDING)
  sentAt           DateTime?          @db.Timestamptz
  failedAt         DateTime?          @db.Timestamptz
  errorMessage     String?
  retryCount       Int                @default(0)
  emailSubject     String?
  externalId       String?
  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([createdAt])
}

model GPSLocation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  truckId        String?  @db.Uuid
  carrierTruckId String?  @db.Uuid
  latitude       Decimal  @db.Decimal(10, 8)
  longitude      Decimal  @db.Decimal(11, 8)
  speed          Int?
  heading        Int?
  altitude       Int?
  accuracy       Decimal? @db.Decimal(6, 2)
  timestamp      DateTime @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  truck        Truck?        @relation(fields: [truckId], references: [id])
  carrierTruck CarrierTruck? @relation(fields: [carrierTruckId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([truckId])
  @@index([timestamp])
  @@index([tenantId, timestamp])
  @@index([carrierTruckId])
  @@index([carrierTruckId, timestamp])
}

model SafetyEvent {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String              @db.Uuid
  truckId    String              @db.Uuid
  driverId   String?             @db.Uuid
  routeId    String?             @db.Uuid
  eventType  SafetyEventType
  severity   SafetyEventSeverity
  gForce     Decimal?            @db.Decimal(4, 2)
  speed      Int?
  speedLimit Int?
  latitude   Decimal             @db.Decimal(10, 8)
  longitude  Decimal             @db.Decimal(11, 8)
  timestamp  DateTime            @db.Timestamptz
  metadata   Json?
  createdAt  DateTime            @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  truck  Truck  @relation(fields: [truckId], references: [id])
  driver User?  @relation(fields: [driverId], references: [id])
  route  Route? @relation(fields: [routeId], references: [id])

  @@index([tenantId])
  @@index([truckId])
  @@index([driverId])
  @@index([routeId])
  @@index([eventType])
  @@index([severity])
  @@index([timestamp])
  @@index([tenantId, timestamp])
}

model FuelRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  truckId     String   @db.Uuid
  fuelType    FuelType
  quantity    Decimal  @db.Decimal(10, 2)
  unitCost    Decimal? @db.Decimal(10, 4)
  totalCost   Decimal? @db.Decimal(10, 2)
  odometer    Int
  location    String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  timestamp   DateTime @db.Timestamptz
  isEstimated Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  truck  Truck  @relation(fields: [truckId], references: [id])

  @@index([tenantId])
  @@index([truckId])
  @@index([timestamp])
  @@index([tenantId, timestamp])
  @@index([isEstimated])
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  assignments TagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TagAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  tagId     String   @db.Uuid
  truckId   String?  @db.Uuid
  userId    String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  truck  Truck? @relation(fields: [truckId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tagId, truckId])
  @@unique([tagId, userId])
  @@index([tenantId])
  @@index([tagId])
  @@index([truckId])
  @@index([userId])
}

model ExpenseCategory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  name            String
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  expenses      RouteExpense[]
  templateItems ExpenseTemplateItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RouteExpense {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  routeId     String    @db.Uuid
  categoryId  String    @db.Uuid
  amount      Decimal   @db.Decimal(10, 2)
  description String
  notes       String?
  deletedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  route    Route           @relation(fields: [routeId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId])
  @@index([routeId])
  @@index([categoryId])
  @@index([deletedAt])
}

model ExpenseTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  tenant Tenant                @relation(fields: [tenantId], references: [id])
  items  ExpenseTemplateItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ExpenseTemplateItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String  @db.Uuid
  categoryId  String  @db.Uuid
  tenantId    String  @db.Uuid
  amount      Decimal @db.Decimal(10, 2)
  description String

  template ExpenseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  tenant   Tenant          @relation(fields: [tenantId], references: [id])

  @@index([templateId])
  @@index([categoryId])
  @@index([tenantId])
}

model RoutePayment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @db.Uuid
  routeId   String        @db.Uuid
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?     @db.Timestamptz
  notes     String?
  deletedAt DateTime?     @db.Timestamptz
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  route  Route  @relation(fields: [routeId], references: [id])

  @@index([tenantId])
  @@index([routeId])
  @@index([status])
  @@index([deletedAt])
}

// ─── CRM Models ─────────────────────────────────────────────

enum CustomerPriority {
  LOW
  MEDIUM
  HIGH
  VIP
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum InteractionType {
  EMAIL
  PHONE
  MEETING
  NOTE
  LOAD_UPDATE
  ETA_NOTIFICATION
}

model Customer {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @db.Uuid
  companyName        String
  contactName        String?
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  zipCode            String?
  priority           CustomerPriority @default(MEDIUM)
  status             CustomerStatus   @default(ACTIVE)
  notes              String?
  emailNotifications Boolean          @default(true)
  totalLoads         Int              @default(0)
  totalRevenue       Decimal          @default(0) @db.Decimal(12, 2)
  lastLoadDate       DateTime?        @db.Timestamptz
  createdAt          DateTime         @default(now()) @db.Timestamptz
  updatedAt          DateTime         @updatedAt @db.Timestamptz

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  interactions CustomerInteraction[]
  loads        Load[]

  @@unique([tenantId, companyName])
  @@index([tenantId])
  @@index([priority])
  @@index([status])
}

model CustomerInteraction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @db.Uuid
  customerId  String          @db.Uuid
  type        InteractionType
  subject     String
  description String?
  isAutomated Boolean         @default(false)
  createdBy   String?         @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([type])
  @@index([createdAt])
}

// ─── Invoice & Billing Models ───────────────────────────────

enum SysAdminInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceItemType {
  LINEHAUL
  FUEL_SURCHARGE
  DETENTION
  STOP_OFF
  LAYOVER
  TONU
  LUMPER
  ACCESSORIAL
  TAX
  OTHER
}

enum InvoiceItemUnit {
  FLAT
  PER_MILE
  PER_CWT
  PER_PIECE
  PER_HOUR
  PERCENT
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @db.Uuid
  customerId    String?       @db.Uuid
  routeId       String?       @db.Uuid
  loadId        String?       @db.Uuid
  invoiceNumber String
  amount        Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @db.Timestamptz
  dueDate       DateTime      @db.Timestamptz
  paidDate      DateTime?     @db.Timestamptz
  notes         String?
  bolNumber     String?
  proNumber     String?
  poNumber      String?
  commodity     String?
  weightLbs     Int?
  pieces        Int?
  loadedMiles   Decimal?      @db.Decimal(10, 2)
  createdById   String?       @db.Uuid
  updatedById   String?       @db.Uuid
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz
  archivedAt    DateTime?     @db.Timestamptz

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  createdBy User?         @relation(name: "InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedBy User?         @relation(name: "InvoiceUpdatedBy", fields: [updatedById], references: [id])
  load      Load?         @relation(fields: [loadId], references: [id])
  items     InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@index([loadId])
  @@index([archivedAt])
  @@index([tenantId, status])
}

model InvoiceItem {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String          @db.Uuid
  tenantId    String          @db.Uuid
  description String
  itemType    InvoiceItemType @default(OTHER)
  unitType    InvoiceItemUnit @default(FLAT)
  quantity    Decimal         @db.Decimal(10, 2)
  unitPrice   Decimal         @db.Decimal(10, 2)
  amount      Decimal         @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
}

// ─── SysAdmin Invoice Models ────────────────────────────────

