{
  "installCommand": "cd ../.. && npm install --legacy-peer-deps",
  "buildCommand": "node scripts/migrate.mjs && prisma generate && next build",
    "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/warmup",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/auto-close-tickets",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/mark-overdue-invoices",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/carrier-auto-dispatch",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/carrier-compliance-alerts",
      "schedule": "0 6 * * *"
    }
  ]
}
