# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Vercel auto-deploy tracking
.vercel-last-deploy

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*.local
.env.local
.env

# mcp config (contains API tokens)
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/*.db
prisma/*.db-journal

/src/generated/prisma

# claude code (local settings may contain tokens)
.claude/

.vercel

# monorepo — workspace app and package artifacts
apps/web/.next/
apps/web/node_modules/
apps/web/playwright-report/
apps/web/test-results/
apps/web/.playwright/
packages/*/dist/
packages/*/node_modules/

# mobile app
apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/dist/
apps/mobile/google-play-key.json

# prevent accidental root-level expo prebuild output
/android/
/ios/
.turbo/
apps/*/.turbo
packages/*/.turbo/